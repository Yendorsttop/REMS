{
  "name": "rems",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "db:validate": "pnpm --filter @rems/database prisma:validate",
    "test": "vitest run",
    "test:db-security": "RUN_DATABASE_INTEGRATION=1 RUN_DATABASE_SECURITY_INTEGRATION=1 vitest run packages/database/src/database-security.integration.test.ts packages/database/src/prisma.integration.test.ts",
    "build": "pnpm -r --if-present build",
    "test:e2e": "playwright test",
    "clean": "find . -name dist -type d -prune -exec rm -rf {} +"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "5.2.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
